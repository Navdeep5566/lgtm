apiVersion: grafana.integreatly.org/v1beta1
kind: GrafanaDashboard
metadata:
  name: d1c-service-health-sre-overview-v2
  namespace: observability
  labels:
    dashboards: grafana-lgtm
    app.kubernetes.io/name: d1c-service-health-sre-overview-v2
    app.kubernetes.io/component: grafana-dashboard
    app.kubernetes.io/part-of: lgtm-observability
spec:
  instanceSelector:
    matchLabels:
      dashboards: grafana-lgtm
  folder: LGTM
  json: |
    {
      "id": null,
      "uid": "d1c-svc-health-v2",
      "title": "D1C App - Service Health & SRE Overview (v2)",
      "description": "Service health + SRE first-look triage: Loki logs/errors/versions, Mimir RED golden signals, firing alerts, and daily ops panels. Does not overwrite uid d1c-svc-health.",
      "tags": [
        "d1c",
        "sre",
        "opentelemetry",
        "loki",
        "mimir",
        "kubernetes",
        "daily-ops",
        "v2"
      ],
      "timezone": "browser",
      "schemaVersion": 39,
      "version": 1,
      "refresh": "30s",
      "editable": true,
      "graphTooltip": 1,
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "timepicker": {
        "refresh_intervals": [
          "10s",
          "30s",
          "1m",
          "5m",
          "15m",
          "30m"
        ]
      },
      "annotations": {
        "list": [
          {
            "builtIn": 1,
            "datasource": {
              "type": "grafana",
              "uid": "-- Grafana --"
            },
            "enable": true,
            "hide": true,
            "iconColor": "rgba(0, 211, 255, 1)",
            "name": "Annotations & Alerts",
            "type": "dashboard"
          },
          {
            "name": "Firing Alerts",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource_mimir}"
            },
            "enable": true,
            "hide": false,
            "iconColor": "red",
            "expr": "ALERTS{alertstate=\"firing\"}",
            "titleFormat": "{{alertname}}",
            "textFormat": "{{annotations.summary}}"
          }
        ]
      },
      "templating": {
        "list": [
          {
            "name": "datasource_loki",
            "type": "datasource",
            "query": "loki",
            "label": "Loki Datasource",
            "hide": 0,
            "current": {},
            "refresh": 1
          },
          {
            "name": "datasource_mimir",
            "type": "datasource",
            "query": "prometheus",
            "label": "Mimir Datasource",
            "hide": 0,
            "current": {},
            "refresh": 1
          },
          {
            "name": "namespace",
            "type": "query",
            "label": "Namespace",
            "datasource": {
              "type": "loki",
              "uid": "${datasource_loki}"
            },
            "query": "label_values({}, k8s_namespace_name)",
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "refresh": 2,
            "sort": 1,
            "current": {
              "text": "All",
              "value": "$__all"
            }
          },
          {
            "name": "service",
            "type": "query",
            "label": "Service",
            "datasource": {
              "type": "loki",
              "uid": "${datasource_loki}"
            },
            "query": "label_values({k8s_namespace_name=\"$namespace\"}, service_name)",
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "refresh": 2,
            "sort": 1,
            "current": {
              "text": "All",
              "value": "$__all"
            }
          },
          {
            "name": "mimir_job",
            "type": "query",
            "label": "App / Job (Mimir)",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource_mimir}"
            },
            "query": "label_values(http_server_request_duration_bucket, job)",
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "refresh": 2,
            "sort": 1,
            "current": {
              "text": "All",
              "value": "$__all"
            }
          },
          {
            "name": "version",
            "type": "query",
            "label": "Version",
            "datasource": {
              "type": "loki",
              "uid": "${datasource_loki}"
            },
            "query": "label_values({k8s_namespace_name=\"$namespace\", service_name=~\"$service\"}, service_version)",
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "refresh": 2,
            "sort": 1,
            "current": {
              "text": "All",
              "value": "$__all"
            }
          },
          {
            "name": "severity",
            "type": "custom",
            "label": "Severity",
            "query": "ERROR,WARN,INFO",
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "current": {
              "text": "All",
              "value": "$__all"
            }
          },
          {
            "name": "fileType",
            "type": "query",
            "label": "File Type",
            "datasource": {
              "type": "loki",
              "uid": "${datasource_loki}"
            },
            "query": "label_values({k8s_namespace_name=\"$namespace\"}, fileType)",
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "refresh": 2,
            "sort": 1,
            "current": {
              "text": "All",
              "value": "$__all"
            }
          }
        ]
      },
      "panels": [
        {
          "id": 16,
          "type": "row",
          "title": "Critical Indicators",
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
          },
          "collapsed": false,
          "panels": []
        },
        {
          "id": 1,
          "type": "stat",
          "title": "Total ERROR Logs (1h)",
          "description": "Total ERROR-level log entries in the last hour. Spikes indicate active incidents.",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 1
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "count_over_time({k8s_namespace_name=\"$namespace\", service_name=~\"$service\"} |= \"ERROR\" [1h])",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 50
                  },
                  {
                    "color": "red",
                    "value": 200
                  }
                ]
              }
            }
          },
          "options": {
            "colorMode": "background",
            "graphMode": "area",
            "reduceOptions": {
              "calcs": [
                "sum"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "value_and_name"
          }
        },
        {
          "id": 2,
          "type": "stat",
          "title": "Active Services",
          "description": "Unique services currently emitting logs. Drop below expected count may mean a service is down.",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 1
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "count(count by (service_name) (rate({k8s_namespace_name=\"$namespace\"}[$__auto])))",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 2
                  },
                  {
                    "color": "green",
                    "value": 5
                  }
                ]
              }
            }
          },
          "options": {
            "colorMode": "background",
            "graphMode": "area",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "value_and_name"
          }
        },
        {
          "id": 3,
          "type": "stat",
          "title": "OTel Export Failures (/min)",
          "description": "OpenTelemetry Collector export failures per minute. Non-zero means telemetry loss.",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 1
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum(count_over_time({k8s_namespace_name=\"$namespace\"} |= \"UnknownHostException|ConnectException\" |= \"opentelemetry-collector\" [1m]))",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 1
                  },
                  {
                    "color": "red",
                    "value": 5
                  }
                ]
              }
            }
          },
          "options": {
            "colorMode": "background",
            "graphMode": "area",
            "reduceOptions": {
              "calcs": [
                "sum"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "value_and_name"
          }
        },
        {
          "id": 13,
          "type": "stat",
          "title": "Pods with OTel Connectivity Issues",
          "description": "Pods hitting UnknownHostException reaching the OTel Collector (telemetry blind spots).",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 1
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "count(count by (k8s_pod_name) (count_over_time({k8s_namespace_name=\"$namespace\"} |= \"UnknownHostException\" |= \"opentelemetry-collector\" [1h])))",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            }
          },
          "options": {
            "colorMode": "background",
            "graphMode": "area",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "value_and_name"
          }
        },
        {
          "id": 17,
          "type": "row",
          "title": "Error Trends & Rates",
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 5
          },
          "collapsed": false,
          "panels": []
        },
        {
          "id": 4,
          "type": "timeseries",
          "title": "Error Log Rate by Service",
          "description": "ERROR log rate over time by service — first place to see which service is failing.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 6
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum by (service_name) (rate({k8s_namespace_name=\"$namespace\", service_name=~\"$service\"} |~ \"ERROR\" [$__interval]))",
              "queryType": "range",
              "refId": "A",
              "direction": "backward",
              "legendFormat": "{{service_name}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 20,
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "spanNulls": true
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull",
                "mean",
                "max"
              ],
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 5,
          "type": "timeseries",
          "title": "Warn vs Error Log Volume",
          "description": "WARN vs ERROR volumes. Rising WARN often precedes ERROR spikes.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 6
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum(rate({k8s_namespace_name=\"$namespace\", service_name=~\"$service\"} |= \"ERROR\" [$__interval]))",
              "queryType": "range",
              "refId": "A",
              "direction": "backward",
              "legendFormat": "ERROR"
            },
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum(rate({k8s_namespace_name=\"$namespace\", service_name=~\"$service\"} |= \"WARN\" [$__interval]))",
              "queryType": "range",
              "refId": "B",
              "direction": "backward",
              "legendFormat": "WARN"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 40,
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "spanNulls": true,
                "stacking": {
                  "mode": "normal",
                  "group": "A"
                }
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull",
                "mean",
                "max"
              ],
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "OTel Export Failure Events Timeline",
          "description": "Failed span/metric export events — telemetry pipeline health.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 14
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum(count_over_time({k8s_namespace_name=\"$namespace\"} |= \"Failed to export spans\" [1m]))",
              "queryType": "range",
              "refId": "A",
              "direction": "backward",
              "legendFormat": "Span Export Failures"
            },
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum(count_over_time({k8s_namespace_name=\"$namespace\"} |= \"Failed to export metrics\" [1m]))",
              "queryType": "range",
              "refId": "B",
              "direction": "backward",
              "legendFormat": "Metric Export Failures"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 15,
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "spanNulls": true
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull",
                "mean",
                "max"
              ],
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 12,
          "type": "timeseries",
          "title": "Log Ingestion Rate by Node (FluentBit)",
          "description": "FluentBit ingestion per node. A drop may mean agent crash or log rotation issues.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 14
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum by (k8s_node_name) (rate({k8s_namespace_name=\"$namespace\", k8s_daemonset_name=\"fluent-bit\"} [$__interval]))",
              "queryType": "range",
              "refId": "A",
              "direction": "backward",
              "legendFormat": "{{k8s_node_name}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 15,
                "lineInterpolation": "smooth",
                "showPoints": "never",
                "spanNulls": true
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull",
                "mean",
                "max"
              ],
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 18,
          "type": "row",
          "title": "Distribution & Breakdown",
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 22
          },
          "collapsed": false,
          "panels": []
        },
        {
          "id": 8,
          "type": "barchart",
          "title": "Top 5 Error-Generating Services (24h)",
          "description": "Services with the most ERROR logs in 24h — prioritize for daily triage.",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 23
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "topk(5, sum by (service_name) (count_over_time({k8s_namespace_name=\"$namespace\"} |= \"ERROR\" [24h])))",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "short"
            }
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        },
        {
          "id": 9,
          "type": "piechart",
          "title": "Log Distribution by Service",
          "description": "Share of total log volume by service (1h).",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 23
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum by (service_name) (count_over_time({k8s_namespace_name=\"$namespace\"} [1h]))",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "values": [
                "value",
                "percent"
              ]
            },
            "pieType": "pie",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          }
        },
        {
          "id": 10,
          "type": "piechart",
          "title": "Log Distribution by File Type",
          "description": "Log volume by fileType label for selected services.",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 23
          },
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${datasource_loki}"
              },
              "editorMode": "code",
              "expr": "sum by (fileType, service_name) (count_over_time({k8s_namespace_name=\"$namespace\", fileType=\"$fileType\", service_name=~\"$service\"} [1h]))",
              "queryType": "instant",
              "refId": "A",
              "direction": "backward"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "values": [
                "value",
                "percent"
              ]
            },
            "pieType": "pie",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          }
        },
        {
          "id": 19,
          "type": "row",
          "title": "Detail Tables & Logs",
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 31
          },
          "collapsed": false,
          "panels": []
        },
        {
          "id": 7,
          "type": "logs",
          "title": "Recent ERROR Logs",
          "description": "Recent ERROR log lines. Fixed query uses |= ERROR (was incorrectly != ERROR).",
          "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 32
          },
          "datasource": {
            "type": "loki",
